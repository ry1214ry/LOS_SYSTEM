# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real credentials.

# ---- Runtime -----------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ---- Database ----------------------------------------------------------
# Preferred on managed cloud Postgres. When set it overrides the DB_* values.
# DATABASE_URL=postgresql://user:password@host:5432/los?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-db-password
DB_DATABASE=LOS-SYSTEM
# Auto-create/alter tables to match the entities. MUST be false in production;
# use migrations there instead.
DB_SYNCHRONIZE=true
DB_SSL=false
DB_REJECT_UNAUTHORIZED=true

# Connection pool (pg). Keep `max` small when fronted by PgBouncer.
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=10000

# ---- Auth --------------------------------------------------------------
# MUST be a long random value and different per environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# HttpOnly refresh cookie. `Secure` is forced on when NODE_ENV=production.
REFRESH_COOKIE_NAME=refresh_token
# COOKIE_DOMAIN=.example.com
COOKIE_SECURE=false

# bcrypt work factor (4–15).
BCRYPT_ROUNDS=12

# ---- HTTP hardening ----------------------------------------------------
# Comma-separated allow-list of browser origins. REQUIRED in production.
CORS_ORIGINS=http://localhost:3000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ---- Optional bootstrap seed ------------------------------------------
# Set SEED_ON_BOOT=true to run the RBAC + super-admin seed on application boot.
SEED_ON_BOOT=false
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=change-me-before-seeding

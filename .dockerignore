.git
.gitignore
.github
.vscode
.idea

# Dependencies and build output are produced inside the image.
node_modules
dist
build
coverage
*.tsbuildinfo

# Never bake secrets or local state into an image layer.
.env
.env.*
!.env.example

# Docs / tests are not needed at runtime.
README.md
test
*.log
npm-debug.log*
.DS_Store
